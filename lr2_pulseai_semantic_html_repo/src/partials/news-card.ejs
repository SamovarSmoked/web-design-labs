<article class="news-card <%= article.featured ? 'news-card--featured' : '' %>" itemscope itemtype="https://schema.org/NewsArticle" data-article-id="<%= article.id %>">
  <figure class="news-card__media">
    <picture class="news-card__picture">
      <source
        type="image/webp"
        srcset="./assets/images/<%= article.imageSlug %>-480w.webp 480w, ./assets/images/<%= article.imageSlug %>-960w.webp 960w"
        sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
      />
      <img
        class="news-card__image"
        src="./assets/images/<%= article.imageSlug %>-480w.jpg"
        srcset="./assets/images/<%= article.imageSlug %>-480w.jpg 480w, ./assets/images/<%= article.imageSlug %>-960w.jpg 960w"
        sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
        alt="<%= article.imageAlt %>"
        width="480"
        height="320"
        loading="lazy"
        itemprop="image"
      />
    </picture>
  </figure>

  <div class="news-card__body">
    <div class="news-card__meta">
      <span class="news-card__badge" itemprop="articleSection" data-i18n="<%= article.topicI18n %>"><%= article.topic %></span>
      <span class="news-card__read-time" data-i18n="article.read_time"><%= article.readTime %></span>
    </div>

    <h3 class="news-card__title" itemprop="headline">
      <a class="news-card__title-link" href="./article.html" data-i18n="<%= article.titleI18n %>"><%= article.title %></a>
    </h3>

    <p class="news-card__excerpt" itemprop="description" data-i18n="<%= article.excerptI18n %>">
      <%= article.excerpt %>
    </p>

    <footer class="news-card__footer">
      <div class="news-card__source-info">
        <span class="news-card__source" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
          <span itemprop="name"><%= article.source %></span>
        </span>
        <span class="news-card__separator" aria-hidden="true">&middot;</span>
        <span class="news-card__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span itemprop="name"><%= article.author %></span>
        </span>
        <span class="news-card__separator" aria-hidden="true">&middot;</span>
        <time class="news-card__date" datetime="<%= article.isoDate %>" itemprop="datePublished"><%= article.date %></time>
      </div>

      <div class="news-card__actions">
        <a class="news-card__read-link" href="./article.html" aria-label="Read full article: <%= article.title %>" data-i18n="card.read_more">Read article</a>
        <button
          class="news-card__bookmark-btn <%= article.bookmarked ? 'news-card__bookmark-btn--active' : '' %>"
          type="button"
          aria-label="<%= article.bookmarked ? 'Remove from bookmarks' : 'Save to bookmarks' %>: <%= article.title %>"
          aria-pressed="<%= article.bookmarked ? 'true' : 'false' %>"
          data-i18n="card.bookmark"
        ><%= article.bookmarked ? 'Bookmarked' : 'Bookmark' %></button>
      </div>
    </footer>
  </div>
</article>
