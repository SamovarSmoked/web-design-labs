                <th class="benchmark-table__cell benchmark-table__cell--head" scope="col" data-i18n="article.col_vram">KV-Cache VRAM</th>
                <th class="benchmark-table__cell benchmark-table__cell--head" scope="col" data-i18n="article.col_acc">RepoBench Recall</th>
              </tr>
            </thead>
            <tbody class="benchmark-table__body">
              <tr class="benchmark-table__row">
                <td class="benchmark-table__cell">Dense FlashAttention-3</td>
                <td class="benchmark-table__cell">14.2 sec</td>
                <td class="benchmark-table__cell">312 GB</td>
                <td class="benchmark-table__cell">99.4%</td>
              </tr>
              <tr class="benchmark-table__row">
                <td class="benchmark-table__cell">Ring-Attention Windowed</td>
                <td class="benchmark-table__cell">8.9 sec</td>
                <td class="benchmark-table__cell">198 GB</td>
                <td class="benchmark-table__cell">94.8%</td>
              </tr>
              <tr class="benchmark-table__row">
                <td class="benchmark-table__cell"><strong>DBSR Block-Sparse (Ours)</strong></td>
                <td class="benchmark-table__cell"><strong>4.5 sec (-68%)</strong></td>
                <td class="benchmark-table__cell"><strong>91 GB (3.4x)</strong></td>
                <td class="benchmark-table__cell"><strong>99.2%</strong></td>
              </tr>
            </tbody>
