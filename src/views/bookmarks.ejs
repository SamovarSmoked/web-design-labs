<!DOCTYPE html>
<html lang="en" data-i18n-lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Manage your saved AI research papers, technical articles, and reading collections on PulseAI." />
  <title data-i18n="meta.bookmarks_title">PulseAI &mdash; Saved Bookmarks &amp; Reading Queue | AI News Aggregator</title>
</head>
<body class="page page--bookmarks">
  <%- include('../partials/header', { activePage: 'bookmarks' }) %>

  <main class="page-main" id="main-content">
    <section class="page-hero" aria-labelledby="bookmarks-page-heading">
      <p class="page-hero__badge" data-i18n="bookmarks.badge">Personal Reading Queue</p>
      <h1 class="page-hero__title" id="bookmarks-page-heading" data-i18n="bookmarks.title">Saved Bookmarks &amp; Research Collections (3)</h1>
      <p class="page-hero__subtitle" data-i18n="bookmarks.subtitle">
        Organize technical papers, hardware deep-dives, and benchmark reports for offline reading.
      </p>
    </section>

    <section class="bookmarks-controls" aria-labelledby="bookmarks-filter-heading">
      <h2 class="bookmarks-controls__title" id="bookmarks-filter-heading" data-i18n="bookmarks.filter_heading">Filter Saved Items</h2>
      <form class="bookmarks-filter-form" action="./bookmarks.html" method="get" role="search" aria-label="Filter saved bookmarks">
        <fieldset class="bookmarks-filter-form__fieldset">
          <legend class="bookmarks-filter-form__legend" data-i18n="bookmarks.filter_legend">Search and Filter Reading Queue</legend>

          <div class="bookmarks-filter-form__group">
            <label class="bookmarks-filter-form__label" for="bookmark-search" data-i18n="bookmarks.search_label">Keyword:</label>
            <input
              class="bookmarks-filter-form__input"
              id="bookmark-search"
              type="search"
              name="q"
              placeholder="Search saved bookmarks..."
              aria-label="Search saved bookmarks by keyword"
              data-i18n-placeholder="bookmarks.search_placeholder"
            />
          </div>

          <div class="bookmarks-filter-form__group">
            <label class="bookmarks-filter-form__label" for="collection-select" data-i18n="bookmarks.collection_label">Collection Folder:</label>
            <select class="bookmarks-filter-form__select" id="collection-select" name="collection" aria-label="Filter bookmarks by collection">
              <option value="all" data-i18n="collections.all">All Saved (3)</option>
              <option value="papers" data-i18n="collections.research">Research Papers (1)</option>
              <option value="toread" data-i18n="collections.toread">To Read (1)</option>
              <option value="hardware" data-i18n="collections.hardware">Hardware (1)</option>
            </select>
          </div>

          <button class="btn btn--primary" type="submit" aria-label="Filter saved bookmarks" data-i18n="bookmarks.apply_btn">Filter Queue</button>
        </fieldset>
      </form>
    </section>

    <div class="page-main__layout">
      <section class="bookmarks-list" aria-labelledby="saved-items-heading">
        <h2 class="bookmarks-list__title" id="saved-items-heading" data-i18n="bookmarks.list_heading">Bookmarked Articles</h2>
        <div class="bookmarks-list__grid">
        <article class="news-card news-card--featured" itemscope itemtype="https://schema.org/NewsArticle" data-article-id="art-1">
          <figure class="news-card__media">
            <picture class="news-card__picture">
              <source
                type="image/webp"
                srcset="./assets/images/hero-neural-480w.webp 480w, ./assets/images/hero-neural-960w.webp 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
              />
              <img
                class="news-card__image"
                src="./assets/images/hero-neural-480w.jpg"
                srcset="./assets/images/hero-neural-480w.jpg 480w, ./assets/images/hero-neural-960w.jpg 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
                alt="Abstract optical neural network architecture representing sparse attention routing"
                width="480"
                height="320"
                loading="lazy"
                itemprop="image"
              />
            </picture>
          </figure>

          <div class="news-card__body">
            <div class="news-card__meta">
              <span class="news-card__badge" itemprop="articleSection" data-i18n="topics.llms">LLMs & Agents</span>
              <span class="news-card__read-time" data-i18n="article.read_time">6 min read</span>
            </div>

            <h3 class="news-card__title" itemprop="headline">
              <a class="news-card__title-link" href="./article.html" data-i18n="articles.art1.title">Sparse Attention Architectures Cut Million-Token Context Latency by 68%</a>
            </h3>

            <p class="news-card__excerpt" itemprop="description" data-i18n="articles.art1.excerpt">
              Researchers introduce hierarchical block-sparse routing that dynamically prunes KV-cache memory overhead during long-context autoregressive decoding.
            </p>

            <footer class="news-card__footer">
              <div class="news-card__source-info">
                <span class="news-card__source" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
                  <span itemprop="name">ArXiv AI Digest</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <span class="news-card__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                  <span itemprop="name">Dr. Elena Vance</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <time class="news-card__date" datetime="2026-11-07" itemprop="datePublished">Nov 07, 2026</time>
              </div>

              <div class="news-card__actions">
                <a class="news-card__read-link" href="./article.html" aria-label="Read full article: Sparse Attention Architectures Cut Million-Token Context Latency by 68%" data-i18n="card.read_more">Read article</a>
                <button
                  class="news-card__bookmark-btn news-card__bookmark-btn--active"
                  type="button"
                  aria-label="Remove from bookmarks: Sparse Attention Architectures Cut Million-Token Context Latency by 68%"
                  aria-pressed="true"
                  data-i18n="card.bookmark"
                >Bookmarked</button>
              </div>
            </footer>
          </div>
        </article>

        <article class="news-card" itemscope itemtype="https://schema.org/NewsArticle" data-article-id="art-2">
          <figure class="news-card__media">
            <picture class="news-card__picture">
              <source
                type="image/webp"
                srcset="./assets/images/robotics-arm-480w.webp 480w, ./assets/images/robotics-arm-960w.webp 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
              />
              <img
                class="news-card__image"
                src="./assets/images/robotics-arm-480w.jpg"
                srcset="./assets/images/robotics-arm-480w.jpg 480w, ./assets/images/robotics-arm-960w.jpg 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
                alt="High-precision industrial robotic arm in an automated research laboratory"
                width="480"
                height="320"
                loading="lazy"
                itemprop="image"
              />
            </picture>
          </figure>

          <div class="news-card__body">
            <div class="news-card__meta">
              <span class="news-card__badge" itemprop="articleSection" data-i18n="topics.robotics">Robotics & Edge</span>
              <span class="news-card__read-time" data-i18n="article.read_time">5 min read</span>
            </div>

            <h3 class="news-card__title" itemprop="headline">
              <a class="news-card__title-link" href="./article.html" data-i18n="articles.art2.title">Closed-Loop Visuomotor Policies Enable Sub-Millimeter Robotic Assembly</a>
            </h3>

            <p class="news-card__excerpt" itemprop="description" data-i18n="articles.art2.excerpt">
              End-to-end diffusion policies trained on synthetic physics simulations transfer zero-shot to bimanual industrial manipulators at 120Hz control rates.
            </p>

            <footer class="news-card__footer">
              <div class="news-card__source-info">
                <span class="news-card__source" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
                  <span itemprop="name">IEEE Spectrum AI</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <span class="news-card__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                  <span itemprop="name">Marcus Chen</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <time class="news-card__date" datetime="2026-11-06" itemprop="datePublished">Nov 06, 2026</time>
              </div>

              <div class="news-card__actions">
                <a class="news-card__read-link" href="./article.html" aria-label="Read full article: Closed-Loop Visuomotor Policies Enable Sub-Millimeter Robotic Assembly" data-i18n="card.read_more">Read article</a>
                <button
                  class="news-card__bookmark-btn news-card__bookmark-btn--active"
                  type="button"
                  aria-label="Remove from bookmarks: Closed-Loop Visuomotor Policies Enable Sub-Millimeter Robotic Assembly"
                  aria-pressed="true"
                  data-i18n="card.bookmark"
                >Bookmarked</button>
              </div>
            </footer>
          </div>
        </article>

        <article class="news-card" itemscope itemtype="https://schema.org/NewsArticle" data-article-id="art-3">
          <figure class="news-card__media">
            <picture class="news-card__picture">
              <source
                type="image/webp"
                srcset="./assets/images/silicon-wafer-480w.webp 480w, ./assets/images/silicon-wafer-960w.webp 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
              />
              <img
                class="news-card__image"
                src="./assets/images/silicon-wafer-480w.jpg"
                srcset="./assets/images/silicon-wafer-480w.jpg 480w, ./assets/images/silicon-wafer-960w.jpg 960w"
                sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 368px"
                alt="Macro view of a silicon photonic AI processor wafer with optical waveguides"
                width="480"
                height="320"
                loading="lazy"
                itemprop="image"
              />
            </picture>
          </figure>

          <div class="news-card__body">
            <div class="news-card__meta">
              <span class="news-card__badge" itemprop="articleSection" data-i18n="topics.hardware">AI Hardware</span>
              <span class="news-card__read-time" data-i18n="article.read_time">8 min read</span>
            </div>

            <h3 class="news-card__title" itemprop="headline">
              <a class="news-card__title-link" href="./article.html" data-i18n="articles.art3.title">Wafer-Scale Optical Interconnects Break the Memory Wall for Trillion-Parameter Models</a>
            </h3>

            <p class="news-card__excerpt" itemprop="description" data-i18n="articles.art3.excerpt">
              Co-packaged silicon photonics deliver 14.4 TB/s chip-to-chip bandwidth at 1.2 picojoules per bit, eliminating copper SERDES bottlenecks.
            </p>

            <footer class="news-card__footer">
              <div class="news-card__source-info">
                <span class="news-card__source" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
                  <span itemprop="name">SemiAnalysis Weekly</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <span class="news-card__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                  <span itemprop="name">Liam O'Connor</span>
                </span>
                <span class="news-card__separator" aria-hidden="true">&middot;</span>
                <time class="news-card__date" datetime="2026-11-05" itemprop="datePublished">Nov 05, 2026</time>
              </div>

              <div class="news-card__actions">
                <a class="news-card__read-link" href="./article.html" aria-label="Read full article: Wafer-Scale Optical Interconnects Break the Memory Wall for Trillion-Parameter Models" data-i18n="card.read_more">Read article</a>
                <button
                  class="news-card__bookmark-btn news-card__bookmark-btn--active"
                  type="button"
                  aria-label="Remove from bookmarks: Wafer-Scale Optical Interconnects Break the Memory Wall for Trillion-Parameter Models"
                  aria-pressed="true"
                  data-i18n="card.bookmark"
                >Bookmarked</button>
              </div>
            </footer>
          </div>
        </article>
        </div>
      </section>

      <aside class="reading-stats" aria-labelledby="reading-stats-heading">
        <h2 class="reading-stats__title" id="reading-stats-heading" data-i18n="bookmarks.stats_heading">Reading Queue Summary</h2>
        <table class="stats-table" aria-label="Saved Bookmarks Breakdown by Collection">
          <caption class="stats-table__caption" data-i18n="bookmarks.stats_caption">Saved articles and estimated reading time</caption>
          <thead class="stats-table__head">
            <tr class="stats-table__row">
              <th class="stats-table__cell stats-table__cell--head" scope="col" data-i18n="bookmarks.col_folder">Collection</th>
              <th class="stats-table__cell stats-table__cell--head" scope="col" data-i18n="bookmarks.col_count">Items</th>
              <th class="stats-table__cell stats-table__cell--head" scope="col" data-i18n="bookmarks.col_time">Est. Time</th>
            </tr>
          </thead>
          <tbody class="stats-table__body">
            <tr class="stats-table__row">
              <td class="stats-table__cell">Research Papers</td>
              <td class="stats-table__cell">1</td>
              <td class="stats-table__cell">6 min</td>
            </tr>
            <tr class="stats-table__row">
              <td class="stats-table__cell">To Read</td>
              <td class="stats-table__cell">1</td>
              <td class="stats-table__cell">5 min</td>
            </tr>
            <tr class="stats-table__row">
              <td class="stats-table__cell">Hardware</td>
              <td class="stats-table__cell">1</td>
              <td class="stats-table__cell">8 min</td>
            </tr>
          </tbody>
        </table>
      </aside>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
