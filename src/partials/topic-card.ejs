<article class="topic-card" data-topic-id="<%= topic.id %>">
  <header class="topic-card__header">
    <span class="topic-card__code" aria-hidden="true"><%= topic.code %></span>
    <span class="topic-card__growth" data-i18n="<%= topic.growthI18n %>"><%= topic.growth %></span>
  </header>

  <h3 class="topic-card__title" data-i18n="<%= topic.nameI18n %>"><%= topic.name %></h3>
  <p class="topic-card__description" data-i18n="<%= topic.descI18n %>"><%= topic.description %></p>

  <footer class="topic-card__footer">
    <span class="topic-card__stats" data-i18n="topic.stats"><%= topic.articlesCount %> articles &middot; <%= topic.sourcesCount %> sources</span>
    <button
      class="topic-card__follow-btn <%= topic.followed ? 'topic-card__follow-btn--following' : '' %>"
      type="button"
      aria-label="<%= topic.followed ? 'Unfollow topic' : 'Follow topic' %> <%= topic.name %>"
      aria-pressed="<%= topic.followed ? 'true' : 'false' %>"
      data-i18n="<%= topic.followed ? 'topic.following' : 'topic.follow' %>"
    ><%= topic.followed ? 'Following' : 'Follow Topic' %></button>
  </footer>
</article>
